[Unit]
Description=Taiga Model Context Protocol (MCP) Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/taiga-mcp
Environment="SERVER_OPTS=-Dconfig.file=/srv/taiga-mcp/resources/application.yaml -Dlogback.configurationFile=/srv/taiga-mcp/resources/logback.xml"
ExecStart=/srv/taiga-mcp/server
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=taiga-mcp

[Install]
WantedBy=default.target
