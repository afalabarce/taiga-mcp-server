[Unit]
Description=Taiga Model Context Protocol (MCP) Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h

# Optional environment overrides
EnvironmentFile=-%h/.env
EnvironmentFile=-%h/taiga-mcp.env
EnvironmentFile=-/etc/taiga-mcp/taiga-mcp.env
Environment="SERVER_OPTS=-Dconfig.file=%h/resources/application.yaml -Dlogback.configurationFile=%h/resources/logback.xml"

ExecStart=%h/bin/server
Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=taiga-mcp

[Install]
WantedBy=default.target
